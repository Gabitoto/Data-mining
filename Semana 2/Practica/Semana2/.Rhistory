# ahora pasamos al dos
# Vamos a inspeccionar, por ejemplo, las hojas 5 y 6
hojas_localidades <- datos[5:8] # Tomamos un rango para asegurarnos
# Unimos el texto de esas hojas y dividimos por líneas
lineas_loc <- unlist(strsplit(hojas_localidades, "\n"))
# Buscamos líneas que parezcan datos (que tengan al menos un número al final)
lineas_loc <- trimws(lineas_loc)
# Supongamos que en las líneas extraídas, las localidades están entre la 10 y la 200
# Nota: Ajustar estos índices según el contenido de 'lineas_loc'
tabla_loc_raw <- lineas_loc[5:282]
# Usamos el patrón de 2 o más espacios que ya aplicaste
matriz_loc <- str_split_fixed(tabla_loc_raw, " {2,}", 10)
# Conversión a Data Frame y limpieza
tabla_localidades <- as.data.frame(matriz_loc)
View(tabla_localidades)
library(tidyr) # Fundamental para la función fill()
# 1. Definir nombres de columnas basados en la imagen
mis_nombres_loc <- c(
"Departamento", "Localidad",
"Conf_2020", "Fall_2020",
"Conf_2021", "Fall_2021",
"Conf_2022", "Fall_2022",
"Conf_Total", "Fall_Total"
)
# 2. Procesar las líneas extraídas
# Filtramos líneas que no contienen datos (como el pie de página o cabeceras vacías)
lineas_filtradas <- tabla_loc_raw[str_detect(tabla_loc_raw, "\\d")] # Solo líneas con números
# 3. Convertir a matriz y luego a data frame
# Usamos 10 columnas según el esquema de la imagen
matriz_loc <- str_split_fixed(lineas_filtradas, " {2,}", 10)
df_localidades <- as.data.frame(matriz_loc, stringsAsFactors = FALSE)
colnames(df_localidades) <- mis_nombres_loc
# 4. Corregir el desplazamiento de columnas
# Si la fila NO tenía departamento, el texto de 'Localidad' quedó en la col 'Departamento'
# Detectamos esto si la segunda columna está vacía o si la primera no es un nombre de Dept conocido
df_corregido <- df_localidades %>%
mutate(
# Si la col 2 está vacía, movemos todo a la derecha
Localidad = ifelse(Localidad == "", Departamento, Localidad),
Departamento = ifelse(Departamento == Localidad, NA, Departamento)
) %>%
# 5. Rellenar los Departamentos (Fill down)
fill(Departamento, .direction = "down") %>%
# 6. Limpieza final: quitar filas que son totales de departamento o ruidos
filter(!str_detect(Localidad, "Total|Fuente|Sala de Situación"))
# 7. Convertir columnas numéricas de una vez
df_corregido <- df_corregido %>%
mutate(across(Conf_2020:Fall_Total, ~as.numeric(str_replace_all(., "\\.", ""))))
View(df_corregido)
# 1. Convertimos los blancos en NA reales para que 'fill' pueda trabajar
df_localidades[df_localidades == ""] <- NA
# 2. Corregimos el desplazamiento
# En los PDF, si la celda de Depto estaba vacía, la Localidad suele saltar a la columna 1.
# Reacomodamos: Si 'Localidad' es NA, movemos el contenido de 'Departamento' a 'Localidad'.
df_ajustado <- df_localidades %>%
mutate(
# Si la columna Localidad está vacía, el nombre de la ciudad quedó en Departamento
Localidad_Final = ifelse(is.na(Localidad), Departamento, Localidad),
# Si movimos el dato, dejamos Departamento como NA para rellenarlo después
Depto_Temp = ifelse(Departamento == Localidad_Final, NA, Departamento)
) %>%
# Nos quedamos solo con las columnas que queremos y renombramos
select(Departamento = Depto_Temp, Localidad = Localidad_Final, everything()) %>%
select(-Localidad_Final, -Depto_Temp) # Limpieza de columnas auxiliares
# 3. EL PASO CLAVE: Rellenar hacia abajo (Forward Fill)
# Esto toma el último valor no-NA y lo copia en los NAs siguientes.
df_final <- df_ajustado %>%
fill(Departamento, .direction = "down")
# 4. Limpieza de filas de basura (como encabezados de página que se filtraron)
# Filtramos para que solo queden filas donde 'Localidad' no sea el nombre de la cabecera
df_final <- df_final %>%
filter(!Localidad %in% c("Localidad", "Localidades", "")) %>%
filter(!is.na(Conf_2020)) # Aseguramos que la fila tenga datos numéricos
# Verificamos los primeros resultados
head(df_final)
# 2. Corregimos el desplazamiento
# En los PDF, si la celda de Depto estaba vacía, la Localidad suele saltar a la columna 1.
# Reacomodamos: Si 'Localidad' es NA, movemos el contenido de 'Departamento' a 'Localidad'.
df_ajustado <- df_localidades %>%
mutate(
# Si la columna Localidad está vacía, el nombre de la ciudad quedó en Departamento
Localidad_Final = ifelse(is.na(Localidad), Departamento, Localidad),
# Si movimos el dato, dejamos Departamento como NA para rellenarlo después
Depto_Temp = ifelse(Departamento == Localidad_Final, NA, Departamento)
) %>%
# Nos quedamos solo con las columnas que queremos y renombramos
select(Departamento = Depto_Temp, Localidad = Localidad_Final, everything()) %>%
select(-Localidad_Final, -Depto_Temp) # Limpieza de columnas auxiliares
# 1. Convertimos blancos a NA para que R los reconozca
df_localidades[df_localidades == ""] <- NA
# 2. Aplicamos la lógica de corrección sin duplicar nombres
df_limpio <- df_localidades %>%
mutate(
# Si la columna Localidad es NA, significa que el nombre de la ciudad
# se filtró a la columna Departamento.
Nueva_Localidad = ifelse(is.na(Localidad), Departamento, Localidad),
Nuevo_Depto = ifelse(Departamento == Nueva_Localidad, NA, Departamento)
) %>%
# 3. REEMPLAZO TOTAL: Seleccionamos solo las corregidas y las numéricas
# Esto elimina las columnas originales "Departamento" y "Localidad" que causaban el error
select(
Departamento = Nuevo_Depto,
Localidad = Nueva_Localidad,
# Seleccionamos el resto de las columnas (las numéricas) por su posición o nombre
3:10
) %>%
# 4. Rellenamos el Departamento hacia abajo
fill(Departamento, .direction = "down") %>%
# 5. Quitamos filas de basura (encabezados de página repetidos)
filter(!is.na(Localidad) & Localidad != "Localidad")
# 6. Limpieza de puntos en números y conversión a numérico
df_final <- df_limpio %>%
mutate(across(3:10, ~as.numeric(str_replace_all(., "\\.", ""))))
# Verificamos
View(df_final)
# 1. Partimos de la matriz cruda para evitar nombres duplicados
df_raw <- as.data.frame(matriz_loc, stringsAsFactors = FALSE)
# 2. Re-alineación lógica
# Analizamos la columna V2: si contiene números, la fila está desplazada a la izquierda.
df_alineado <- df_raw %>%
mutate(
# ¿V2 es un número? (Detecta si hay dígitos)
es_desplazada = str_detect(V2, "\\d"),
# Si está desplazada: el Depto es NA y la Localidad es V1
# Si NO está desplazada: el Depto es V1 y la Localidad es V2
Depto_Limpio = ifelse(es_desplazada, NA, V1),
Loc_Limpia   = ifelse(es_desplazada, V1, V2),
# Ajustamos los datos numéricos según el desplazamiento
C2020 = ifelse(es_desplazada, V2, V3),
F2020 = ifelse(es_desplazada, V3, V4),
C2021 = ifelse(es_desplazada, V4, V5),
F2021 = ifelse(es_desplazada, V5, V6),
C2022 = ifelse(es_desplazada, V6, V7),
F2022 = ifelse(es_desplazada, V7, V8)
)
# 3. Aplicamos el relleno (Fill) y limpieza final
df_final <- df_alineado %>%
# Seleccionamos solo las columnas nuevas y útiles
select(Departamento = Depto_Limpio, Localidad = Loc_Limpia,
C2020, F2020, C2021, F2021, C2022, F2022) %>%
# Rellenamos el nombre del departamento hacia abajo
fill(Departamento, .direction = "down") %>%
# Filtramos filas que no son datos (encabezados de años o filas vacías)
filter(!is.na(C2020),
!str_detect(Localidad, "2020|2021|Localidad|Total")) %>%
# Convertimos a numérico (quitando puntos de miles si existen)
mutate(across(C2020:F2022, ~as.numeric(str_replace_all(., "\\.", ""))))
# Verificamos el resultado
View(df_final)
