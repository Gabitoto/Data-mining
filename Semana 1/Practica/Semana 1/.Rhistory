url_base <- "https://statistics.stanford.edu/people/alumni"
paginas <- 0:11
lista_tablas <- list() # Creamos una lista vacía para guardar los resultados
# 2. El Bucle (Iteración)
for (i in paginas) {
# Construimos la URL dinámica
url_completa <- paste0(url_base, "?page=", i)
print(paste("Procesando página:", i))
# Leemos la página (R Base usa el motor interno de xml2)
# Nota: Si te da error de conexión, Stanford te está pidiendo el User-Agent
# que vimos antes. Sin httr es más difícil "engañarlo", pero probemos así:
pagina <- try(read_html(url_completa, encoding = "UTF-8"))
if (inherits(pagina, "try-error")) {
message(paste("No se pudo acceder a la página", i))
next # Salta a la siguiente iteración si hay error
}
# --- Tu lógica de extracción ---
header_css <- ".hb-table-pattern__row"
header <- pagina %>%
html_elements(header_css) %>%
html_elements("div") %>%
html_text(trim = TRUE)
cssTabla <- ".hb-table-pattern__body"
cssFila <- ".hb-table-row"
cssCamposAlumno <- ".hb-table-row__column"
filas <- pagina %>%
html_elements(css = cssTabla) %>%
html_elements(css = cssFila) %>%
html_elements(css = cssCamposAlumno) %>%
html_text(trim = TRUE)
# Verificamos si hay datos antes de crear la matriz
if (length(filas) > 0) {
# Armamos la tabla de esta página
tabla_pag <- data.frame(matrix(filas, ncol = length(header), byrow = TRUE))
colnames(tabla_pag) <- header
# Guardamos el data frame en nuestra lista
lista_tablas[[i + 1]] <- tabla_pag
}
# Pausa de 2 segundos para no ser bloqueados
Sys.sleep(2)
}
# 3. Consolidación Final (El "Merge")
# do.call aplica la función rbind a todos los elementos de la lista a la vez
tabla_final <- do.call(rbind, lista_tablas)
# Ver resultado
head(tabla_final)
View(tabla_final)
View(tabla_final)
View(tabla_final)
# guardamos los datos en un csv.
library("data.table")
fwrite(tabla, file = "./salidas/paginas-de-alumnos.csv", sep = ";")
fwrite(tabla_final, file = "./salidas/paginas-de-alumnos.csv", sep = ";")
fwrite(tabla_final, file = "./paginas-de-alumnos.csv", sep = ";")
alumni_filtrado <- tabla_final %>%
# Limpiamos el nombre de la columna para que sea más fácil trabajar (Graduation.Year -> year)
rename(year = Graduation.Year) %>%
# Convertimos a numérico por si hay algún carácter extraño
mutate(year = as.numeric(year)) %>%
# Aplicamos el filtro solicitado (1980 - 2007)
filter(year >= 1980 & year <= 2007) %>%
# Ordenamos cronológicamente
arrange(year)
alumni_filtrado <- tabla_final %>%
# Convertimos a numérico por si hay algún carácter extraño
mutate(`Graduation Year` = as.numeric(`Graduation Year`)) %>%
# Aplicamos el filtro solicitado (1980 - 2007)
filter(`Graduation Year` >= 1980 & `Graduation Year` <= 2007) %>%
# Ordenamos cronológicamente
arrange(`Graduation Year`)
show(alumni_filtrado)
View(alumni_filtrado)
View(tabla_final)
View(tabla_final)
View(lista_tablas)
View(alumni_filtrado)
View(alumni_filtrado)
url <- "https://statistics.stanford.edu/people/alumni"
pagina <- read_html(url, encoding = "UTF-8")
# 1. Definimos los selectores (los mismos que ya tenías)
header_css <- ".hb-table-pattern__row"
header <- pagina %>%
html_elements(header_css) %>%
html_elements("div") %>%
html_text(trim = TRUE)
cssTabla <- ".hb-table-pattern__body"
cssFila <- ".hb-table-row"
cssCamposAlumno <- ".hb-table-row__column"
# 2. SELECCIÓN DE FILAS (Capturamos los contenedores, no los textos todavía)
nodos_filas <- pagina %>%
html_elements(css = cssTabla) %>%
html_elements(css = cssFila)
# 3. EXTRACCIÓN ROBUSTA (Iteramos fila por fila)
lista_datos <- lapply(nodos_filas, function(nodo_fila) {
# Extraemos solo los campos de ESTA fila
celdas <- nodo_fila %>%
html_elements(css = cssCamposAlumno) %>%
html_text(trim = TRUE)
# TRUCO DE INGENIERÍA: Forzamos a que cada fila tenga la longitud del header.
# Si faltan campos (como en el 2000), R rellena con NA al final automáticamente.
length(celdas) <- length(header)
return(celdas)
})
# 4. ARMADO DE LA TABLA
# do.call une la lista de vectores en una matriz/data frame sin desfases
tabla_final <- as.data.frame(do.call(rbind, lista_datos))
colnames(tabla_final) <- header
# 5. FILTRADO (1980 - 2007)
# Convertimos el año a numérico para poder filtrar el rango
tabla_final$`Graduation Year` <- as.numeric(tabla_final$`Graduation Year`)
tabla_filtrada <- tabla_final[tabla_final$`Graduation Year` >= 1980 &
tabla_final$`Graduation Year` <= 2007 &
!is.na(tabla_final$`Graduation Year`), ]
# Ordenamos por año para que quede acomodado
tabla_filtrada <- tabla_filtrada[order(tabla_filtrada$`Graduation Year`), ]
# Verificamos
head(tabla_filtrada)
alumni_filtrado <- tabla_final %>%
# Convertimos a numérico por si hay algún carácter extraño
mutate(`Graduation Year` = as.numeric(`Graduation Year`)) %>%
# Aplicamos el filtro solicitado (1980 - 2007)
filter(`Graduation Year` >= 1980 & `Graduation Year` <= 2007) %>%
# Ordenamos cronológicamente
arrange(`Graduation Year`)
