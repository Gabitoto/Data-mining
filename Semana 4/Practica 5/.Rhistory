# Ordenar por Lift (fuerza de la relación)
reglas_ordenadas <- sort(reglas1, by = "lift", decreasing = TRUE)
# Mostrar las 10 mejores reglas
inspect(head(reglas_ordenadas, n = 10))
rm(list = ls())
