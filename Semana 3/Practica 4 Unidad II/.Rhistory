library(tidyverse)
# 1. Leer el archivo
df <- read.csv("Entrenamiento_ECI_2020.csv", stringsAsFactors = TRUE)
# 2. Verificar dimensiones (Filas y Columnas)
dim(df)
# 3. Tipos de datos y estructura
str(df)
# 4. Medidas de resumen
summary(df)
# Ver niveles actuales
levels(df$Stage)
# Discretización: Supongamos que solo nos interesan "Closed Won" y "Closed Lost"
# Filtramos o transformamos según la necesidad del problema
df1 <- df %>%
filter(Stage %in% c("Closed Won", "Closed Lost")) %>%
mutate(Stage = factor(Stage)) # Refactorizamos para eliminar niveles vacíos
