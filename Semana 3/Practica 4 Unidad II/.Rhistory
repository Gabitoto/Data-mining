barplot(table(df1$Region), las = 2, col = "skyblue", main = "Frecuencia por Región")
# Frecuencia de Bureaucratic_Code
barplot(table(df1$Bureaucratic_Code), las = 2, col = "orange", main = "Frecuencia por Bureaucratic Code")
